{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "blognice-staff",
	"main": "src/staff.ts",
	"compatibility_date": "2026-06-20",
	"compatibility_flags": ["nodejs_compat"],
	"vars": {
		"ACCESS_TEAM_DOMAIN": "https://pragmaticonline.cloudflareaccess.com",
      "ACCESS_AUD": "7d2a38820e0e45966e130ba5c0bb2a411c1552dd7fe3000827f31f67a3eea16d",
      "STAFF_ALLOWED_EMAILS": "ray@pragmaticonline.com,scott@pragmaticonline.com,maew@pragmaticonline.com,alex@pragmaticonline.com",
      "EMAIL_FROM": "Blog Nice <support@mailer.blognice.com>",
      "ROOT_DOMAIN": "blognice.com",
      "STRIPE_MONTHLY_PRICE_ID": "price_1U15hNPBZtWrx4qGbiLxr4HL",
      "STRIPE_YEARLY_PRICE_ID": "price_1U15hOPBZtWrx4qGIp4ariDb",
      "AFFILIATE_PAYOUT_DUAL_CONTROL_THRESHOLD_MINOR": "100000",
      "AFFILIATE_STRIPE_CONNECT_COUNTRIES": "US,CA,GB,TH",
      "AFFILIATE_OFFER_EXPERIMENT": "off",
      "CF_ACCOUNT_ID": "30142eba9e53a37522d1c59b298db661"
	},
	"routes": [
		{ "pattern": "staff.blognice.com/*", "zone_name": "blognice.com" }
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "blognice",
			"database_id": "228b44b6-806a-4730-8c44-1b44d01a6536"
		}
	],
	"ai": { "binding": "AI" },
	"queues": { "producers": [{ "binding": "EMAIL_QUEUE", "queue": "blognice-email" }] }
}
